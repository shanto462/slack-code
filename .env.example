# --- Slack ------------------------------------------------------------------
# Bot User OAuth Token. api.slack.com/apps -> your app -> OAuth & Permissions.
SLACK_BOT_TOKEN=xoxb-...
# App-Level Token with the connections:write scope. Basic Information -> App-Level Tokens.
SLACK_APP_TOKEN=xapp-...

# Who is allowed to drive the agent. Slack usernames (no @), display names, or
# raw Uxxxxxxx ids, comma separated. Resolved to ids at startup.
# This is the only thing standing between a workspace member and a shell on this
# machine, so keep it tight.
SLACK_ALLOWED_USERS=your.username

# --- Project ----------------------------------------------------------------
# Every DM thread runs against this one directory.
PROJECT_DIR=/absolute/path/to/project
# Optional friendly name used in Slack messages. Defaults to the directory name.
PROJECT_NAME=

# --- Agent ------------------------------------------------------------------
# default | acceptEdits | bypassPermissions | plan | dontAsk | auto
# bypassPermissions means no approval prompts at all: the agent has unrestricted
# Bash in PROJECT_DIR with nobody watching.
PERMISSION_MODE=bypassPermissions
# Defaults to claude-opus-5. Set only to step down (e.g. sonnet) for cheaper turns.
MODEL=
# Reasoning effort. Defaults to max. low | medium | high | xhigh | max
EFFORT=

# --- Tuning -----------------------------------------------------------------
# Drop an idle in-memory session after this long. The session id is kept on
# disk, so a later reply in the thread still resumes the conversation.
SESSION_IDLE_MINUTES=120
# Minimum gap between edits to the live "working..." message, in ms.
STATUS_UPDATE_MS=2000
# Where thread -> session mapping is stored. Defaults to ./.state
STATE_DIR=
# If a turn produces no output at all for this long, treat it as wedged, reset
# the session, and free the thread. Measured from the last sign of life, so a
# long but active turn is never killed.
TURN_STALL_MINUTES=10
# How far back to sweep for DMs missed while the socket was disconnected.
CATCHUP_WINDOW_HOURS=24
