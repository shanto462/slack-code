<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE. Do not copy this file into ~/Library/LaunchAgents by hand: the
  __PLACEHOLDERS__ below are filled in by `npm run autostart:install`.

  Run-at-login for the UNPACKAGED app.

  The app has its own "run at login" toggle, but Electron's
  app.setLoginItemSettings only works in a packaged build, and the packaged
  build cannot currently persist tokens: an ad-hoc signature fails the Keychain
  lookup, safeStorage reports unavailable, and the app forgets both Slack tokens
  on quit. Until the app is signed with a real Developer ID, this LaunchAgent is
  how run-at-login actually works. Delete it once the toggle does the job.

  The app takes a single-instance lock, so launching it by hand while this is
  loaded hands over to the running copy instead of starting a second bridge.

  HOME/USER/LOGNAME are load-bearing, not boilerplate. Claude Code resolves its
  credentials from the login Keychain via the user identity, so without USER the
  bridge starts fine and then fails every turn with "Not logged in".
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.slackcode.app</string>

    <key>ProgramArguments</key>
    <array>
        <string>__APP_DIR__/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron</string>
        <string>__APP_DIR__</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__APP_DIR__</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/slack-code.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/slack-code.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>USER</key>
        <string>__USER__</string>
        <key>LOGNAME</key>
        <string>__USER__</string>
    </dict>
</dict>
</plist>
